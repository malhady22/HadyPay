<?xml version="1.0" encoding="utf-8"?>
<!-- Native Android launch background shown before Flutter's first
     frame renders, using the HadyPay navy brand color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
